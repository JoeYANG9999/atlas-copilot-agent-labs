// =============================================================================
// 阿特拉斯中国 · Copilot 智能体工作坊 —— 统一开发环境
//
// 学员先 fork，再在自己的 fork 上点 Code → Codespaces → Create codespace on main
// （预构建跟着本仓库走，fork 吃不到，第一次要现装 3~8 分钟）。本地 VS Code + Dev Containers 扩展也能用这一份。
// =============================================================================
{
  "name": "Copilot Agent Labs · Python 3.12 + Node 24",
  // 基于官方 Python 3.12 镜像，只多做一件事：去掉签名过期的 yarn apt 源（见 Dockerfile）
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    // Lab-02 的 Next.js 与 Copilot SDK 要 Node 24
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    // gh：查看 Actions 运行、gh-aw 编译（讲师演示）
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // gh codespace ssh / logs 依赖容器里的 SSH 服务：讲师远程排障、自动化验证都用它
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": ["github.copilot", "github.copilot-chat", "ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      }
    }
  },

  "remoteEnv": {
    // 让 Copilot Agent 在任何终端里敲 python 都用到装好依赖的 .venv
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
    // pptx skill 的脚本在仓库根目录 .github/skills 下，require('playwright') 等依赖
    // 要从 Lab-02 的 node_modules 里找；VS Code Chat 里直接用 Skill 时靠这一行
    "NODE_PATH": "${containerWorkspaceFolder}/Lab-02-Knowledge-Summary/node_modules"
  },

  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Lab-02 知识总结智能体 · Web/API（Lab-03 要设为 Public）", "onAutoForward": "notify" },
    "8080": { "label": "Lab-01 周报网页预览", "onAutoForward": "openBrowser" }
  },

  // Next.js 开发服务器 + Copilot CLI + 无头 Chromium 同时在跑，2 核偏紧，给 4 核
  "hostRequirements": { "cpus": 4 },

  // onCreate 会被 Codespaces 预构建执行并打进镜像（重活放这里）；postCreate 每个学员现跑（只做轻量初始化）。
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",

  "remoteUser": "vscode"
}
